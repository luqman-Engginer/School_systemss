# Backend production env (dibaca langsung dari process.env, tanpa dotenv).
# Di platform host (Railway/Render/Fly), isi sebagai Environment Variables di
# dashboard, BUKAN sebagai file .env.

# Koneksi database MySQL/MariaDB (src/db.js memakai driver mysql2).
# WAJIB. Skema tabel dibuat otomatis saat server pertama kali jalan, tapi
# database itself harus sudah ada. Siapkan dengan:
#   CREATE DATABASE schoolhub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# MySQL minimal 8.0.16 (CHECK constraint baru dipatuhi mulai versi itu) atau
# MariaDB 10.2+. Versi lama akan mengabaikan CHECK dan kolom DEFAULT
# berbasis ekspresi seperti (UTC_TIMESTAMP()) sehingga boot gagal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=schoolhub

# Jumlah koneksi maks di pool (opsional, default 10).
DB_POOL_SIZE=10

# PORT server. Railway/Fly biasanya injecting PORT sendiri; biarkan kosong
# agar memakai nilai yang diberikan platform. Default 5000 bila kosong.
PORT=

# CORS: daftar origin frontend Vercel yang diizinkan, dipisah koma.
# WAJIB diisi di production. Kosong = izinkan semua origin (hanya untuk dev).
# Contoh: CORS_ORIGIN=https://schoolhub.vercel.app,https://schoolhub-git-main.vercel.app
CORS_ORIGIN=

# WAJIB diganti di production. Dipakai untuk tanda tangan JWT (src/auth.js).
# Tanpa ini semua instance memakai secret default yang hardcoded.
# Buat dengan: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Uploads (multer diskStorage). File upload TIDAK ikut ke database, jadi ini
# tetap butuh persistent volume, misalnya /data/uploads.
# relative path dihitung dari folder server/.
UPLOAD_DIR=/data/uploads

# Backup database. Lihat juga scripts/backup.js.
# BACKUP_DIR harus ada di disk yang persisten; salin keluar dari mesin itu juga.
BACKUP_DIR=/data/backups
BACKUP_KEEP=14
