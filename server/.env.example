# Backend production env (dibaca langsung dari process.env, tanpa dotenv).
# Salin ke .env pada host/server deployment.

# Alokasi file database SQLite.
# Di production ARUH KE VOLUME PERSISTENT, mis. /app/data/schoolhub.db atau /var/lib/schoolhub/schoolhub.db.
# Tanpa volume persistent, data HILANG setiap restart/rebuild (khususnya platform ephemeral).
# Folder induk dibuat otomatis bila belum ada.
SQLITE_PATH=/app/data/schoolhub.db

# PORT server (default 5000 bila kosong)
PORT=5000

# CORS: biarkan kosong = izinkan semua origin (paling cocok untuk frontend Vercel).
# Opsional: daftar origin yang diizinkan, dipisah koma.
CORS_ORIGIN=

# Ganti di production! Dipakai untuk tanda tangan JWT.
JWT_SECRET=change-me-to-a-long-random-secret